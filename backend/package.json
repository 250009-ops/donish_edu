{
  "name": "donish-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend API for Gotcha English→Uzbek learning app (auth, materials, vocab, translation).",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "bot": "node bot/index.js",
    "secrets": "node scripts/generate-env-secrets.mjs",
    "webhook:set": "node scripts/set-telegram-webhook.mjs",
    "webhook:info": "node scripts/set-telegram-webhook.mjs --info",
    "webhook:fix": "node scripts/fix-telegram-webhook.mjs",
    "env:audit": "node scripts/audit-env.mjs",
    "env:webhook-secret": "node scripts/ensure-webhook-secret.mjs",
    "db:export-supabase": "node scripts/export-supabase.mjs",
    "db:import": "node scripts/import-postgres.mjs",
    "deploy:website": "node scripts/vps-sync-website.mjs",
    "finish:dns": "node scripts/vps-finish-dns.mjs",
    "deploy:vps": "node scripts/vps-deploy.mjs",
    "go-live": "node scripts/vps-go-live.mjs",
    "admin:create": "node scripts/create-admin.mjs",
    "admin:build": "cd ../admin-panel && npm install && npm run build"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "otplib": "^12.0.1",
    "axios": "^1.7.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.19.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.21.0",
    "telegraf": "^4.16.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.48.0",
    "nodemon": "^3.1.0",
    "ssh2": "^1.17.0"
  }
}
