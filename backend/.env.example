PORT=4000
NODE_ENV=production
API_BASE_URL=https://api.donish.live

# Run: npm run secrets  (writes backend/.env with crypto-strong JWT + bot secrets)
# Production: min 32 random characters for JWT; never commit real values to git.
JWT_SECRET=super-secret-change-me
# Production: min 16 chars; Telegram bot must send the same value as header X-Bot-Secret.
BOT_SHARED_SECRET=generate-a-long-random-string-for-bot-only
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
OPENAI_API_KEY=sk-...
# Amazon Textract — required for PDF text extraction (all uploads use OCR).
AWS_REGION=us-east-1
TEXTRACT_S3_BUCKET=your-private-textract-uploads-bucket
# Credentials: use EC2 instance IAM role in production, or standard AWS env vars locally:
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Optional. If set, Telegram must send matching X-Telegram-Bot-Api-Secret-Token (setWebhook secret_token).
# TELEGRAM_WEBHOOK_SECRET=long-random-string
#
# Telegram webhook (production on EC2):
#   npm run webhook:set
# Webhook URL: https://api.donish.live/bot/telegram-webhook
# Run Supabase migration: db/migration_telegram_bot_sessions.sql
