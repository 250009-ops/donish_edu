PORT=4000
# Run: npm run secrets  (writes backend/.env with crypto-strong values)
# Then copy JWT_SECRET + BOT_SHARED_SECRET into Vercel → Environment Variables (Production).
# Production (Vercel): min 32 random characters for JWT; never commit real values to git.
JWT_SECRET=super-secret-change-me
# Production: min 16 chars; Telegram bot must send the same value as header X-Bot-Secret.
BOT_SHARED_SECRET=generate-a-long-random-string-for-bot-only
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
OPENAI_API_KEY=sk-...
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Optional but recommended for webhook endpoint protection.
# Use this value as Telegram setWebhook `secret_token`.
# TELEGRAM_WEBHOOK_SECRET=long-random-webhook-secret
# Required for protected webhook setup endpoint (/bot/setup-webhook).
# BOT_WEBHOOK_SETUP_SECRET=another-long-random-secret
# Required for serverless webhook URL auto-generation.
# APP_BASE_URL=https://donish-edu.vercel.app
# Optional. Bot uses this to create users. Defaults to https://donish-edu.vercel.app
# API_BASE_URL=https://donish-edu.vercel.app

