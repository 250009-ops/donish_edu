PORT=4000
NODE_ENV=production
API_BASE_URL=https://api.donish.live

# PostgreSQL on VPS (production)
DATABASE_URL=postgresql://donish:your-db-password@127.0.0.1:5432/donish

# Run: npm run secrets  (writes JWT + bot secrets)
JWT_SECRET=super-secret-change-me
JWT_EXPIRES_IN=3d
BOT_SHARED_SECRET=generate-a-long-random-string-for-bot-only
OPENAI_API_KEY=sk-...
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=generate-a-long-random-string-for-webhook

# Premium billing (set true to enforce free-tier limits + checkout)
BILLING_ENABLED=false

# Lemon Squeezy (Premium subscriptions — only when BILLING_ENABLED=true)
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_VARIANT_ID=
LEMON_SQUEEZY_PRODUCT_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=
CHECKOUT_URL=
PREMIUM_PRICE_UZS=56000
PREMIUM_REDIRECT_URL=https://donish.live/home#pricing
MAX_DEVICES_PER_USER=3
FREE_MAX_MATERIALS=1
FREE_MAX_TRANSLATE_TOTAL=5
PREMIUM_MAX_TRANSLATE_PER_DAY=500

# Bot admin (Telegram IDs for /upload_app, comma-separated)
BOT_ADMIN_IDS=

# App download fallbacks
APK_DOWNLOAD_URL=
IOS_STORE_URL=

# Admin panel
ADMIN_JWT_SECRET=
ADMIN_TOTP_ENC_KEY=
ADMIN_ACCESS_TTL=30m
ADMIN_REFRESH_TTL=7d
ADMIN_IP_ALLOWLIST=

# Deploy scripts only (do not commit real values):
# IP=170.168.6.42
# PASSWORD=vps-root-password
# DOMAIN=vps8944.eskiz.uz
# DB_PASSWORD=postgres-password-for-donish-user

# One-time Supabase export (remove after migration):
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=...
