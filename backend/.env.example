PORT=4000
# Run: npm run secrets  (writes backend/.env with crypto-strong values)
# Then copy JWT_SECRET + BOT_SHARED_SECRET into Vercel → Environment Variables (Production).
# Production (Vercel): min 32 random characters for JWT; never commit real values to git.
JWT_SECRET=super-secret-change-me
# Production: min 16 chars; Telegram bot must send the same value as header X-Bot-Secret.
BOT_SHARED_SECRET=generate-a-long-random-string-for-bot-only
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
OPENAI_API_KEY=sk-...
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Required for Vercel webhook mode (same token as the bot). Long-polling `npm run bot` also uses it.
# Optional. If set, Telegram must send matching X-Telegram-Bot-Api-Secret-Token (setWebhook secret_token).
# TELEGRAM_WEBHOOK_SECRET=long-random-string
# Optional. Bot uses this to call /bot/create-user. On Vercel, set to your public API URL.
# API_BASE_URL=https://donish-edu.vercel.app
#
# Webhook URL to give Telegram (not the site root):
#   https://<your-domain>/bot/telegram-webhook
# Run Supabase migration: db/migration_telegram_bot_sessions.sql

