---
import { SITE } from "../config/site";

interface Props {
  class?: string;
  showText?: boolean;
  /** Use white text on purple hero/header backgrounds */
  light?: boolean;
}

const { class: className = "", showText = true, light = false } = Astro.props;
---

<a
  href="/"
  class:list={["logo", className, { "logo--light": light }]}
  aria-label={`${SITE.name} home`}
>
  {showText && <span class="logo__text">{SITE.name}</span>}
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    color: var(--color-heading);
  }

  .logo--light {
    color: #fff;
  }

  .logo__text {
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
</style>
